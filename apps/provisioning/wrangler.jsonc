// Provisioning API and admin panel (design v7 2.1, 2.4): one Worker per env
// on admin.<app> and api.<app>, deployed by the CI `provisioning` target.
//
// Deploy with --env staging or --env prod only: the top level has no name and
// no main, so a deploy without --env is refused. No routes, custom domains or
// workers.dev here: admin.<app>/* and api.<app>/* are wired by
// scripts/ops/hosted-zones.sh. Placeholders ({{...}}) are filled at deploy.
// Workers Logs on for console output only (#164): invocation logs stay off,
// because they hold request URLs, and query strings are redacted from the
// URLs that other log entries carry (sign-in codes and state, OAuth codes).
// This Worker holds no Cloudflare token (2.5); the provisioner does.
// Secrets (set by CI only if absent, 4.6): ADMIN_SESSION_KEY (32 random
// bytes), ADMIN_BROKER_KEY (Ed25519 pkcs8). MCP adds none (2.4).
// ADMIN_IDENTITIES, the `email:sub` comma list (4.1, #1007), is a secret:
// the deploy Environment's, put by CI on every deploy, never committed. A
// var of the same name would conflict, so there is none here.
// MCP_REDIRECT_URIS: exact redirect URIs besides loopback (9A.3.1); the
// Claude.ai callback is unverified until acceptance (14.4).
// SIGNUP_DAILY_CAP: the provisioner's and scheduler's cap, the same
// placeholder, so R27's signup_cap runs with their value (9A.5).
// ADMIN_SESSION_TTL_HOURS: staging only (168); adminSessionTtlMs ignores it
// outside staging, so prod stays at 8 h.
// OIDC_* (4.4) are staging only; the prod deploy read-back refuses them.
// Ratelimit namespace ids: staging 1141-1146, prod 1151-1156 (4.7, 9A.7).
// ASSETS: the admin SPA build: `pnpm --filter @oa/admin build` writes straight into dist-assets (@oa/admin is a devDependency, so `pnpm --filter @oa/provisioning... build` builds it first).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "preview_urls": false,
  "env": {
    "staging": {
      "name": "oa-s-provisioning",
      "main": "src/index.ts",
      "workers_dev": false,
      "preview_urls": false,
      "observability": {
        "enabled": true,
        "redact_query_string": true,
        "logs": {
          "enabled": true,
          "invocation_logs": false,
          "head_sampling_rate": 1
        }
      },
      // Hourly MCP client sweep (sweepOAuthClients): unclaimed after 24 h,
      // any client after 30 days, with its grants.
      "triggers": {
        "crons": ["41 * * * *"]
      },
      "vars": {
        "OA_ENV": "staging",
        "ADMIN_SESSION_TTL_HOURS": "168",
        "APP_DOMAIN": "open-artifacts-staging.app",
        "SIGNUPS_ENABLED": "{{SIGNUPS_ENABLED_STAGING}}",
        "SELF_SERVE_TIER": "trial",
        "SIGNUP_DAILY_CAP": "{{SIGNUP_DAILY_CAP_STAGING}}",
        // The sender of the approval email (#2096), the provisioner's value.
        "WELCOME_FROM": "{{WELCOME_FROM_STAGING}}",
        "MCP_REDIRECT_URIS": "https://claude.ai/api/mcp/auth_callback",
        "OIDC_AUDIENCE": "https://api.open-artifacts-staging.app",
        "OIDC_REPOSITORY": "open-artifacts-ai/open-artifacts-cloud",
        "OIDC_REPOSITORY_ID": "{{GITHUB_REPOSITORY_ID_STAGING}}",
        "OIDC_JOB_WORKFLOW_REFS": "open-artifacts-ai/open-artifacts-cloud/.github/workflows/redline-staging.yml@refs/heads/main,open-artifacts-ai/open-artifacts-cloud/.github/workflows/staging-test-admin.yml@refs/heads/main,open-artifacts-ai/open-artifacts-cloud/.github/workflows/staging-test-member.yml@refs/heads/main",
        "OIDC_ENVIRONMENT": "redline-staging"
      },
      "d1_databases": [
        {
          "binding": "PLATFORM_DB",
          "database_name": "oa-s-platform",
          "database_id": "{{PLATFORM_DB_ID_STAGING}}"
        }
      ],
      "workflows": [
        {
          "binding": "PROVISION_INSTALL",
          "name": "oa-s-provision-install",
          "class_name": "ProvisionInstall",
          "script_name": "oa-s-provisioner"
        },
        {
          "binding": "MANAGE_INSTALL",
          "name": "oa-s-manage-install",
          "class_name": "ManageInstall",
          "script_name": "oa-s-provisioner"
        }
      ],
      // The platform's own release: what an upgrade or create defaults to.
      "version_metadata": { "binding": "CF_VERSION_METADATA" },
      // The approval email (#2096): the provisioner's sender, no fixed destination.
      "send_email": [{ "name": "WELCOME_EMAIL" }],
      // BILLING is STAGING ONLY (#66): billing's BillingOperatorRpc entrypoint,
      // how an operator sets an install's tier (set_install_tier). oa-s-billing
      // must be deployed first, and the deploy reads the binding back when the
      // tag declares it. Prod has no BILLING binding.
      "services": [
        {
          "binding": "PROVISIONER",
          "service": "oa-s-provisioner",
          "entrypoint": "ProvisionerRpc"
        },
        {
          "binding": "AUTH_BROKER",
          "service": "oa-s-auth-broker"
        },
        {
          "binding": "BILLING",
          "service": "oa-s-billing",
          "entrypoint": "BillingOperatorRpc"
        }
      ],
      "queues": {
        "producers": [
          {
            "binding": "SIGNUPS",
            "queue": "oa-s-signups"
          }
        ]
      },
      "assets": {
        "directory": "./dist-assets",
        "binding": "ASSETS",
        "not_found_handling": "single-page-application",
        "run_worker_first": true
      },
      "ratelimits": [
        {
          "name": "RL_PV_PRE_IP",
          "namespace_id": "1141",
          "simple": {
            "limit": 600,
            "period": 60
          }
        },
        {
          "name": "RL_PV_SIGNIN_IP",
          "namespace_id": "1142",
          "simple": {
            "limit": 10,
            "period": 60
          }
        },
        {
          "name": "RL_PV_WRITE",
          "namespace_id": "1143",
          "simple": {
            "limit": 30,
            "period": 60
          }
        },
        {
          "name": "RL_PV_READ",
          "namespace_id": "1144",
          "simple": {
            "limit": 300,
            "period": 60
          }
        },
        {
          "name": "RL_PV_SLUG_IP",
          "namespace_id": "1145",
          "simple": {
            "limit": 30,
            "period": 60
          }
        },
        {
          "name": "RL_PV_OAUTH_IP",
          "namespace_id": "1146",
          "simple": {
            "limit": 20,
            "period": 60
          }
        },
        {
          "name": "RL_PV_ADMIN_ESCAPE",
          "namespace_id": "1147",
          "simple": {
            "limit": 60,
            "period": 60
          }
        },
        {
          "name": "RL_PV_TOKEN_WRITE",
          "namespace_id": "1148",
          "simple": {
            "limit": 10,
            "period": 60
          }
        }
      ],
      "kv_namespaces": [
        {
          "binding": "OAUTH_KV",
          "id": "{{PROVISIONING_OAUTH_KV_ID_STAGING}}"
        }
      ]
    },
    "prod": {
      "name": "oa-p-provisioning",
      "main": "src/index.ts",
      "workers_dev": false,
      "preview_urls": false,
      "observability": {
        "enabled": true,
        "redact_query_string": true,
        "logs": {
          "enabled": true,
          "invocation_logs": false,
          "head_sampling_rate": 1
        }
      },
      // Hourly MCP client sweep (sweepOAuthClients): unclaimed after 24 h,
      // any client after 30 days, with its grants.
      "triggers": {
        "crons": ["41 * * * *"]
      },
      "vars": {
        "OA_ENV": "prod",
        "APP_DOMAIN": "open-artifacts.app",
        "SIGNUPS_ENABLED": "false",
        "SELF_SERVE_TIER": "trial",
        "SIGNUP_DAILY_CAP": "{{SIGNUP_DAILY_CAP_PROD}}",
        // The sender of the approval email (#2096), the provisioner's value.
        "WELCOME_FROM": "{{WELCOME_FROM_PROD}}",
        "MCP_REDIRECT_URIS": "https://claude.ai/api/mcp/auth_callback"
      },
      "d1_databases": [
        {
          "binding": "PLATFORM_DB",
          "database_name": "oa-p-platform",
          "database_id": "{{PLATFORM_DB_ID_PROD}}"
        }
      ],
      "workflows": [
        {
          "binding": "PROVISION_INSTALL",
          "name": "oa-p-provision-install",
          "class_name": "ProvisionInstall",
          "script_name": "oa-p-provisioner"
        },
        {
          "binding": "MANAGE_INSTALL",
          "name": "oa-p-manage-install",
          "class_name": "ManageInstall",
          "script_name": "oa-p-provisioner"
        }
      ],
      // The platform's own release: what an upgrade or create defaults to.
      "version_metadata": { "binding": "CF_VERSION_METADATA" },
      // The approval email (#2096): the provisioner's sender, no fixed destination.
      "send_email": [{ "name": "WELCOME_EMAIL" }],
      "services": [
        {
          "binding": "PROVISIONER",
          "service": "oa-p-provisioner",
          "entrypoint": "ProvisionerRpc"
        },
        {
          "binding": "AUTH_BROKER",
          "service": "oa-p-auth-broker"
        }
      ],
      "queues": {
        "producers": [
          {
            "binding": "SIGNUPS",
            "queue": "oa-p-signups"
          }
        ]
      },
      "assets": {
        "directory": "./dist-assets",
        "binding": "ASSETS",
        "not_found_handling": "single-page-application",
        "run_worker_first": true
      },
      "ratelimits": [
        {
          "name": "RL_PV_PRE_IP",
          "namespace_id": "1151",
          "simple": {
            "limit": 600,
            "period": 60
          }
        },
        {
          "name": "RL_PV_SIGNIN_IP",
          "namespace_id": "1152",
          "simple": {
            "limit": 10,
            "period": 60
          }
        },
        {
          "name": "RL_PV_WRITE",
          "namespace_id": "1153",
          "simple": {
            "limit": 30,
            "period": 60
          }
        },
        {
          "name": "RL_PV_READ",
          "namespace_id": "1154",
          "simple": {
            "limit": 300,
            "period": 60
          }
        },
        {
          "name": "RL_PV_SLUG_IP",
          "namespace_id": "1155",
          "simple": {
            "limit": 30,
            "period": 60
          }
        },
        {
          "name": "RL_PV_OAUTH_IP",
          "namespace_id": "1156",
          "simple": {
            "limit": 20,
            "period": 60
          }
        },
        {
          "name": "RL_PV_ADMIN_ESCAPE",
          "namespace_id": "1157",
          "simple": {
            "limit": 60,
            "period": 60
          }
        },
        {
          "name": "RL_PV_TOKEN_WRITE",
          "namespace_id": "1158",
          "simple": {
            "limit": 10,
            "period": 60
          }
        }
      ],
      "kv_namespaces": [
        {
          "binding": "OAUTH_KV",
          "id": "{{PROVISIONING_OAUTH_KV_ID_PROD}}"
        }
      ]
    }
  }
}
