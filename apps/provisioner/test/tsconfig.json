{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    // DOM, tests only: provision's src and fake-cf use DOM types
    // workers-types lacks (BlobPart, FormDataEntryValue).
    "lib": ["ES2022", "DOM"],
    "types": [
      "@cloudflare/workers-types",
      "node",
      "@cloudflare/vitest-plugin/types"
    ]
  },
  // build-flags.d.ts: the server sources imported by gmail-signup-owner.test.ts
  // read the __OA_TEST_HOOKS_ALLOWED__ bundler define.
  "include": [
    ".",
    "../src",
    "../vitest.config.ts",
    "../vitest.node.config.ts",
    "../../server/src/build-flags.d.ts"
  ]
}
